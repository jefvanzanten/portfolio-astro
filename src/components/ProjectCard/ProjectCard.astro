---
import { Picture } from "astro:assets";
import type { Project } from "../../types/project";
import GithubLink from "../GithubLink/GithubLink.astro";
import LinkAction from "../LinkAction/LinkAction.astro";
import ExternalLinkContent from "../ExternalLinkContent/ExternalLinkContent.astro";
import ProjectImageTrigger from "../ProjectImageModal/ProjectImageTrigger.svelte";
import { projectPages } from "../../data.ts";

interface Props {
  project: Project;
  index?: number;
  priority?: boolean;
  filterId?: string;
}

const { project, index = 0, priority = false, filterId } = Astro.props;

const projectPage = projectPages.find((p) => p.slug === project.slug);
---

<article
  style={{ "--card-index": index }}
  class="project-card-container"
  data-project-card
  data-project-filter-id={filterId}
>
  <ProjectImageTrigger
    client:visible
    imageUrl={project.coverUrl}
    className="image-container"
    ariaLabel={`Open screenshot van ${project.name}`}
  >
    <Picture
      class="thumb"
      src={project.thumbImage}
      alt={`${project.name} cover`}
      formats={["avif", "webp"]}
      widths={[320, 640]}
      sizes="(max-width: 640px) 90vw, (max-width: 940px) 45vw, (max-width: 1400px) 31vw, 320px"
      fetchpriority={priority ? "high" : "low"}
      loading={priority ? "eager" : "lazy"}
      decoding="async"
    />
  </ProjectImageTrigger>
  <a
    class="project-info-link"
    href={projectPage ? `/projects/${projectPage.slug}` : undefined}
  >
    <section class="project-info">
      <h2 class="title">{project.name}</h2>
      <div class="description" set:html={project.descriptionHtml} />
      <div class="tag-container">
        {
          project.languages.map((language) => (
            <span class="tag">{language}</span>
          ))
        }
        {project.libraries.map((library) => <span class="tag">{library}</span>)}
      </div>
    </section>
  </a>
  {
    (project.url || project.liveUrl || project.downloadUrl || projectPage) && (
      <div class="card-actions">
        {project.url && (
          <GithubLink
            name="GitHub"
            iconUrl="/icons/github-mark-white.svg"
            url={project.url}
          />
        )}
        {project.liveUrl && (
          <LinkAction url={project.liveUrl} label="Bekijk live">
            <ExternalLinkContent />
          </LinkAction>
        )}
        {projectPage && (
          <LinkAction
            url={`/projects/${projectPage.slug}`}
            label="Bekijk pagina"
            pageLink
          >
            <ExternalLinkContent />
          </LinkAction>
        )}
      </div>
    )
  }
</article>

<style>
  .project-card-container {
    --project-card-border: #000;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--card-bg);
    border: 1px solid var(--project-card-border);
    color: var(--card-text-color);
    width: 100%;
    height: 100%;
    border-radius: 0.5em;
    padding-bottom: 0.5em;
    opacity: 1;
    transform: translateY(0);
    position: relative;

    @media screen and (max-width: 640px) and (max-height: 667px) {
      align-self: flex-start;
      height: auto;
    }

    &:hover {
      border: 1px solid var(--project-card-border);
      translate: 0 -6px;
    }

    @media (prefers-reduced-motion: no-preference) {
      animation: fallIn 0.45s ease-out backwards;
      animation-delay: calc(var(--card-index, 0) * 0.06s);
    }

    :global(.image-container) {
      all: unset;
      display: block;
      position: relative;
      z-index: 2;
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      width: 100%;
      overflow: hidden;
      border-radius: 10px 10px 0 0;
      border-bottom: 1px solid var(--project-card-border, rgba(0, 0, 0, 0.5));
      background:
        linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.01),
          rgba(255, 255, 255, 0.01)
        ),
        var(--bg);

      &::before {
        content: "";
        display: block;
        padding-top: var(--project-card-image-ratio, 75%);

        @media screen and (max-width: 640px) and (max-height: 667px) {
          --project-card-image-ratio: 50%;
          padding-top: var(--project-card-image-ratio, 75%);
        }

        @media screen and (max-width: 640px) and (height: 932px) {
          --project-card-image-ratio: 80%;
          padding-top: var(--project-card-image-ratio, 75%);
        }
      }

      &::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            180deg,
            rgba(8, 10, 14, 0.08) 0%,
            rgba(8, 10, 14, 0.02) 100%
          ),
          rgba(0, 0, 0, 0.08);
        pointer-events: none;
        z-index: 1;
      }
    }

    :global(.image-container .thumb) {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      cursor: pointer;
      z-index: 0;
      transition: transform 0.22s ease-out;
    }

    :global(.image-container:hover .thumb) {
      transform: scale(1.02);
    }

    .project-info-link {
      color: inherit;
      text-decoration: none;

      &[href] {
        cursor: pointer;

        &::after {
          content: "";
          position: absolute;
          inset: 0;
          z-index: 1;
        }

        &:focus-visible {
          outline: none;

          &::after {
            outline: 2px solid var(--accent-bright);
            outline-offset: 3px;
            border-radius: 0.5em;
          }
        }
      }
    }

    .project-info {
      display: flex;
      flex-direction: column;
      width: 100%;
      padding: 1em;

      @media screen and (min-width: 1024px) {
        padding: 0.5em 1.3em;
      }
    }

    .title {
      display: block;
      font-family: "JetBrains Mono", monospace;
      font-weight: 500;
      text-align: center;
      color: var(--card-title-color);
      width: 100%;
      font-size: 1rem;
      padding: 0.5rem 0;
      margin: 0;

      @media screen and (max-width: 640px) and (max-height: 667px) {
        font-size: 0.88rem;
      }

      @media screen and (min-width: 1920px) {
        font-size: 1.13rem;
      }
    }

    .description {
      font-size: 0.82rem;
      white-space: normal;
      padding: 0.5rem 0 0;

      :global(p) {
        margin: 0 0 1em;
      }

      :global(p:last-child) {
        margin-bottom: 0;
      }

      @media screen and (max-width: 770px) {
        font-size: 0.88rem;
      }

      @media screen and (max-width: 640px) and (max-height: 667px) {
        font-size: 0.82rem;
      }

      @media screen and (min-width: 1920px) {
        font-size: 0.8rem;
      }
    }

    .tag-container {
      display: flex;
      flex-direction: row;
      margin-top: 2rem;
      gap: 0.7rem;
      flex-wrap: wrap;
      justify-content: center;

      @media screen and (max-width: 640px) and (max-height: 667px) {
        gap: 0.4rem;
      }
    }

    .tag {
      border-radius: 0.4em;
      color: color-mix(in oklch, var(--text), var(--accent-bright) 14%);
      background-color: color-mix(in oklch, var(--card-bg), #000 30%);
      border: 1px solid color-mix(in oklch, var(--border), var(--accent) 28%);
      font-size: 0.57rem;
      font-weight: 600;
      padding: 0.3rem 0.3rem;
    }

    .card-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      width: 100%;
      margin-top: auto;
      padding: 1rem 1rem 0.75rem;

      :global(a) {
        position: relative;
        z-index: 2;
      }
    }
  }

  @keyframes fallIn {
    from {
      opacity: 0.72;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
