---
const { iconUrl = "/icons/external-link.svg", name = "Bekijk live" } =
  Astro.props;
---

<img class="icon" src={iconUrl} alt={`${name} logo`} />

<style>
  .icon {
    height: 18px;
    width: 18px;
    object-fit: contain;
    flex-shrink: 0;

    @media screen and (min-width: 1024px) {
      height: 18px;
      width: 18px;
    }
  }
</style>
