---
import LinkAction from "../LinkAction/LinkAction.astro";
const {
  url,
  iconUrl,
  name,
  iconOnly = false,
  variant = "secondary",
  target = url.startsWith("/") ? undefined : "_blank",
  rel = target === "_blank" ? "noreferrer" : undefined,
} = Astro.props;
---

<LinkAction
  url={url}
  label={name}
  iconOnly={iconOnly}
  variant={variant}
  target={target}
  rel={rel}
>
  <img class="logo" src={iconUrl} alt={`${name} logo`} />
</LinkAction>

<style>
  .logo {
    height: 18px;
    width: 18px;
    object-fit: contain;
    flex-shrink: 0;
  }
</style>
