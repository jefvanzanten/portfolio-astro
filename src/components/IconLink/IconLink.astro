---
import type { HTMLAttributes } from "astro/types";
import LinkAction from "../LinkAction/LinkAction.astro";

type Props = Omit<HTMLAttributes<"a">, "aria-label" | "href"> & {
  href: string;
  label: string;
  iconUrl: string;
  variant?: "primary" | "secondary";
};

const {
  href,
  label,
  iconUrl,
  variant = "secondary",
  class: className,
  title = label,
  ...attributes
} = Astro.props;

const classes = [
  "iconLink",
  variant === "primary" && "primary",
  className,
].filter(Boolean);
---

<LinkAction
  {...attributes}
  href={href}
  class={classes.join(" ")}
  aria-label={label}
  title={title}
>
  <img class="icon" src={iconUrl} alt="" aria-hidden="true" />
  <span class="label">{label}</span>
</LinkAction>

<style>
  :global(.iconLink) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    box-sizing: border-box;
    min-height: 3rem;
    padding: 0.3rem 0.4rem;
    border: 1px solid var(--button-secondary-border);
    border-radius: 10px;
    color: var(--text-muted);
    text-decoration: none;
    background: linear-gradient(
      180deg,
      var(--button-secondary-bg-start),
      var(--button-secondary-bg-end)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 0 0 rgba(0, 0, 0, 0);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;

    @media screen and (max-width: 640px) {
      padding: 0 0.5rem;
    }

    &:hover {
      transform: translateY(-2px);
      border-color: var(--border-bright);
      background: linear-gradient(
        180deg,
        var(--button-secondary-hover-start),
        var(--button-secondary-hover-end)
      );
    }

    &:focus-visible {
      outline: 2px solid color-mix(in oklch, var(--accent-bright), white 25%);
      outline-offset: 3px;
    }

    &:link,
    &:visited {
      color: var(--text-muted);
      text-decoration: none;
    }

    .icon {
      height: 18px;
      width: 18px;
      object-fit: contain;
      flex-shrink: 0;
    }

    &.primary {
      border-color: var(--accent-bright);
      background: color-mix(in oklch, var(--accent-bright), black 14%);
      color: #000;
      box-shadow: 0 10px 24px
        color-mix(in oklch, var(--accent-bright), transparent 86%);

      &:hover {
        border-color: color-mix(in oklch, var(--accent-bright), white 12%);
        background: color-mix(in oklch, var(--accent-bright), black 8%);
        box-shadow: 0 14px 30px
          color-mix(in oklch, var(--accent-bright), transparent 82%);
      }

      .icon {
        filter: brightness(0) saturate(0) invert(0%);
      }
    }

    .label {
      font-size: 12px;
      line-height: 1;
      font-weight: 600;
      letter-spacing: 0.01em;

      @media screen and (min-width: 1024px) {
        font-size: 12px;
      }

      @media screen and (max-width: 640px) and (height: 667px) {
        font-size: 11px;
      }
    }
  }
</style>
