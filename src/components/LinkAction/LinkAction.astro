---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & {
  href: string;
};

const { href, target, rel, ...attributes } = Astro.props;
const opensNewTab =
  target === "_blank" || (!target && /^https?:\/\//.test(href));
const resolvedTarget = target ?? (opensNewTab ? "_blank" : undefined);
const resolvedRel = rel ?? (opensNewTab ? "noopener noreferrer" : undefined);
---

<a {...attributes} href={href} target={resolvedTarget} rel={resolvedRel}>
  <slot />
</a>
