---
import Layout from "../Layout.astro";
import { projects } from "../data.ts";
import CarouselFallback from "../components/Carousel/CarouselFallback.astro";
import ProjectCard from "../components/ProjectCard/ProjectCard.astro";
import ProjectsFilters from "../components/ProjectsView/ProjectsFilters.svelte";
import ProjectImageModalWrapper from "../components/ProjectImageModal/ProjectImageModalWrapper.svelte";

const allTech = [
  ...new Set(
    projects.flatMap((project) => [...project.languages, ...project.libraries]),
  ),
].join(", ");
const description = `Projecten van Jef (Jeffrey) van Zanten - Fullstack developer. Technologieen: ${allTech}.`;

const filterableProjects = projects.map(
  ({ category, languages, libraries }, index) => ({
    filterId: String(index),
    category,
    languages,
    libraries,
  }),
);
const projectsViewId = "projects-view";
const projectNavigationItems = projects.map((project, index) => ({
  id: `project-${index + 1}`,
  label: project.name,
}));
---

<Layout title="Projects - jefvanzanten.dev" description={description}>
  <section class="projects-page">
    <div class="content-container">
      <ProjectsFilters client:idle projects={filterableProjects} />

      <div id={projectsViewId} class="projects-view">
        <section
          class="project-container"
          data-snap-track
          role="region"
          aria-label="Projecten"
          tabindex="0"
        >
          {
            projects.map((project, index) => (
              <div
                id={`project-${index + 1}`}
                class="project-item"
                data-snap-item
              >
                <ProjectCard
                  project={project}
                  index={index}
                  filterId={String(index)}
                />
              </div>
            ))
          }
        </section>

        <CarouselFallback
          rootId={projectsViewId}
          items={projectNavigationItems}
          navigationLabel="Kies een project"
          alignment="start"
          mobileOnly
          navigationType="counter"
        />
      </div>

      <p class="empty-state" data-projects-empty hidden>
        Geen projecten gevonden met deze filters.
      </p>
    </div>

    <ProjectImageModalWrapper client:idle />
  </section>
</Layout>

<style>
  :global(html) {
    --projects-filter-height: 8.5rem;
    /*scroll-behavior: smooth;*/
    scroll-snap-type: y mandatory;
    scroll-padding-top: calc(var(--nav-height) + var(--projects-filter-height));

    @media screen and (max-width: 767px) {
      scroll-padding-top: var(--nav-height);
    }

    @media screen and (max-width: 640px) {
      scroll-snap-type: none;
    }
  }

  .projects-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding-bottom: 8vh;

    .content-container {
      width: min(calc(100% - 3rem), var(--page-content-width));
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      margin: 0 auto;

      .projects-view {
        width: 100%;
      }

      .project-container {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2em;
        width: 100%;

        .project-item {
          display: contents;

          &[hidden] {
            display: none;
          }

          > :global([data-project-card]) {
            scroll-snap-align: center;
          }
        }

        @media screen and (max-width: 940px) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media screen and (max-width: 640px) {
        .projects-view {
          > :global(.carousel-fallback-navigation) {
            display: flex;
            justify-content: center;
            max-width: 100%;
            overflow-x: auto;
            scrollbar-width: none;
          }
        }

        .project-container {
          display: flex;
          gap: 1rem;
          overflow-x: auto;
          overscroll-behavior-inline: contain;
          scroll-behavior: smooth;
          scroll-snap-type: x mandatory;
          scrollbar-width: none;

          &::-webkit-scrollbar {
            display: none;
          }

          &:focus-visible {
            outline: 2px solid var(--accent-bright);
            outline-offset: 3px;
          }

          .project-item {
            --project-card-image-ratio: 50%;
            display: block;
            flex: 0 0 100%;
            scroll-snap-align: start;
            scroll-snap-stop: always;
          }
        }
      }

      .empty-state {
        color: var(--text-muted);
        padding-bottom: 1rem;
      }

      @media screen and (max-width: 940px) {
        width: 90%;
        gap: 0.5rem;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-page .project-container {
      scroll-behavior: auto;
    }
  }
</style>
